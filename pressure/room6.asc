// room script file

function room_AfterFadeIn()
{
  ShowNarration(oSpeaker, "It's Tuesday now");
  Wait(120);
  
  ShowNarration(oSpeaker, "Since they all are free, they do their own thing for the day.");
  Wait(240);
  
  PlayVideo("Videos/TuesdayHoliday.ogv", eVideoSkipEscKey, 0);
  
  ShowNarration(oSpeaker, "Until night came");
  Wait(120);
  
  ShowJames(oSpeaker, "Adha?", 13);
  Wait(120);
  
  ShowAdha(oSpeaker, "Yes.", 7);
  Wait(120);
  
  HideDialogue(oSpeaker);
  
  ShowJames(oSpeaker, "I haven't seen you studying since morning. Do you want to study together.",  12);
  Wait(300);
  
  HideDialogue(oSpeaker);
  
  ShowAziz(oSpeaker, "We still have 3 days left man, chill.",  10);
  Wait(180);
  
  ShowAziz(oSpeaker, "Wanna hop on the game? We still missing one more member.", 10);
  Wait(180);
  
  HideDialogue(oSpeaker);
  
  ShowChoices("Study with James", "Hop on the game", "");
}

function room_RepExec()
{
  if (LastChoice == 1){
    ShowJames(oSpeaker, "Smart choices", 12);
    JamesP++;
    Wait(120);
    HideDialogue(oSpeaker);
    //video here
    ShowNarration(oSpeaker, "MORE MESSAGE HERE IM LAZY");
    Wait(120);
    HideDialogue(oSpeaker);
    player.ChangeRoom(8);
  }
  else if (LastChoice == 2){
    ShowAziz(oSpeaker, "I knew I could trust you", 10);
    AzizP++;
    Wait(120);
    PlayVideo("Videos/Adha_Playing", eVideoSkipEscKey, 0);
    player.ChangeRoom(7);
  }
}
