// room script file

function room_AfterFadeIn()
{
  PlayVideo("Videos/Mom_CAnswered.ogv", eVideoSkipEscKey, 0);
  
  ShowAdha(oSpeaker, "Hello mom", 1);
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "(Mom): Hello Adha.");
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "(Mom): I just want to inform you that allowance may be late since the companies made a massive laid off.");
  Wait(300);
  HideDialogue(oSpeaker);
  
  ShowAdha(oSpeaker, "What? Does that mean we don't have money right now? This semester is still not paid yet.", 7);
  Wait(240);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "(Mom): I know, this job pay less so we are still trying to bounce back. Can you visit Finance Office and see what option we have?");
  Wait(360);
  HideDialogue(oSpeaker);
  
  ShowAdha(oSpeaker, "Alright...", 1);
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "Adha hang up the call and think about this until fell asleep");
  Wait(180);
  HideDialogue(oSpeaker);
  
}
