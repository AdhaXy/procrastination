// room script file

function room_AfterFadeIn()
{
  SetBackgroundFrame(0);
  ShowNarration(oSpeaker, "Wednesday came and Adha went to class");
  Wait(120);
  HideDialogue(oSpeaker);
  
  PlayVideo("Videos/Class_Transition.ogv", eVideoSkipEscKey, 0);
  SetBackgroundFrame(1);
  
  ShowNarration(oSpeaker, "After everything end, Adha came to hostel");
  Wait(180);
  HideDialogue(oSpeaker);
  
  PlayVideo("Videos/Adha_EnterHostel.ogv", eVideoSkipEscKey, 0);
  PlayVideo("Videos/Adha_ToTable.ogv", eVideoSkipEscKey, 0);
  PlayVideo("Videos/Adha_PlayGame.ogv", eVideoSkipEscKey, 0);
  
  SetBackgroundFrame(2);
  
  ShowNarration(oSpeaker, "Adha play games to release some stress.");
  Wait(180);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "But his mom called him in the middle of the game");
  Wait(240);
  HideDialogue(oSpeaker);
  
  ShowChoices("Pick up the call", "Missed on purpose", "");
}

function room_RepExec()
{
  // answer mom call
  if (LastChoice == 1){
    player.ChangeRoom(12);
  }
  // ignored mom call
  else if (LastChoice == 2){
    player.ChangeRoom(12);
  }
}
