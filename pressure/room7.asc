// room script file

function room_AfterFadeIn()
{
  ShowNarration(oSpeaker, "Adha play games with Aziz.");
  Wait(180);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "Until someone called him.");
  Wait(120);
  HideDialogue(oSpeaker);
  
  PlayVideo("Videos/Mom_CAnswered", eVideoSkipEscKey, 0);
  SetBackgroundFrame(1);
  
  ShowNarration(oSpeaker, "Adha?");
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowAdha(oSpeaker, "Yes Mom", 1);
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "(Mom): How are you? What are you doing right now?");
  Wait(240);
  HideDialogue(oSpeaker);
  
  ShowAdha(oSpeaker, "I'm fine, right now I am studying mom.", 1);
  Wait(180);
  HideDialogue(oSpeaker);
  
  ShowAziz(oSpeaker, "Hey Adha, look at what I got!", 18);
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowAdha(oSpeaker, "Shh!!", 7);
  Wait(120);
  HideDialogue(oSpeaker);
  
  ShowNarration(oSpeaker, "Are you lying to me Adha?!");
  Wait(180);
  HideDialogue(oSpeaker);
  
  
  if (AzizP >1){
    ShowAdha(oSpeaker, "Adha in his mind 'she always like this'", 1);
    Wait(180);
    HideDialogue(oSpeaker);
    
    ShowNarration(oSpeaker, "The called end after a while");
    Wait(120);
    HideDialogue(oSpeaker);
    
    PlayVideo("Videos/PutPhone.ogv", eVideoSkipEscKey, 0);
    
    ShowNarration(oSpeaker, "Adha played for a bit and sleep in the end");
    Wait(180);
    HideDialogue(oSpeaker);
    player.ChangeRoom(9);
  }
  else {
    ShowAdha(oSpeaker, "I'm sorry mom", 7);
    Wait(120);
    HideDialogue(oSpeaker);
    
    ShowNarration(oSpeaker, "The called end after a while");
    Wait(120);
    HideDialogue(oSpeaker);
    
    PlayVideo("Videos/PutPhone.ogv", eVideoSkipEscKey, 0);
    
    ShowNarration(oSpeaker, "Adha played for a bit and sleep in the end");
    Wait(180);
    HideDialogue(oSpeaker);
    player.ChangeRoom(8);
  }
  
}
