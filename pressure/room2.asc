// room script file

function room_AfterFadeIn()
{
  ShowChoices("Follow James to class", "sleep for 15 more minute", "Trust Aziz");

}

function room_RepExec()
{
  if (LastChoice == 1) {
    PlayVideo("Videos/Adha_ClassWJames.ogv", eVideoSkipEscKey, 0);
    // timelapse here
    player.ChangeRoom(4);
  }
  else if (LastChoice == 2) {
    PlayVideo("Videos/Adha_Alarm.ogv", eVideoSkipEscKey, 0);
    ShowNarration(oSpeaker, "Adha go to class alone");
    // video here
    player.ChangeRoom(4);
  }
  else if (LastChoice == 3) {
    ShowNarration(oSpeaker, "Aziz remember this");
    HideDialogue(oSpeaker);
    // place for aziz wake up adha video
    player.ChangeRoom(3);
  }
}
