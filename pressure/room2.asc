// room script file

function room_AfterFadeIn()
{
  ShowJames(oSpeaker, "Adha, let's go to class.", 6);
  Wait(120);
  
  HideDialogue(oSpeaker);
  
  ShowChoices("Follow James to class", "sleep for 15 more minute", "Trust Aziz");

}

function room_RepExec()
{
  if (LastChoice == 1) {
    ShowNarration(oSpeaker, "James will remember this");
    JamesP ++;
    Wait(120);
    PlayVideo("Videos/Adha_ClassWJames.ogv", eVideoSkipEscKey, 0);
    PlayVideo("Videos/Class_Transition.ogv", eVideoSkipEscKey, 0);
    player.ChangeRoom(4);
  }
  else if (LastChoice == 2) {
    ShowNarration(oSpeaker, "Adha put up an alarm and went to sleep");
    Wait(180);
    HideDialogue(oSpeaker);
    
    PlayVideo("Videos/Adha_Alarm.ogv", eVideoSkipEscKey, 0);
    
    ShowNarration(oSpeaker, "Adha go to class alone");
    Wait(120);
    HideDialogue(oSpeaker);
    
    PlayVideo("Videos/Adha_ClassAlone.ogv", eVideoSkipEscKey, 0);
    PlayVideo("Videos/Class_Transition.ogv", eVideoSkipEscKey, 0);
    player.ChangeRoom(4);
  }
  else if (LastChoice == 3) {
    ShowNarration(oSpeaker, "Aziz remember this");
    AzizP++;
    Wait(120);
    HideDialogue(oSpeaker);
    // place for aziz wake up adha video
    player.ChangeRoom(3);
  }
}
