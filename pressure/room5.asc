// room script file

function room_AfterFadeIn()
{
  ShowNarration(oSpeaker, "James arrive at hostel and come to Adha");
  Wait(120);
  
  HideDialogue(oSpeaker);
  Wait(60);
  
  ShowDialogue(oSpeaker, "Yo Adha.", 6);
  Wait(120);
  
  ShowDialogue(oSpeaker, "What?", 7);
  Wait(120);
  
  ShowDialogue(oSpeaker, "The exam is in 5 days, do you want to study together?",  6);
  Wait(300);
  
  // play video
  PlayVideo("Videos/Adha_OpenBook.ogv", eVideoSkipEscKey, 0);
  
  SetBackgroundFrame(1);
  
  ShowNarration(oSpeaker, "They study until night and tomorrow came");
  
}