// room script file

function room_AfterFadeIn()
{
  ShowNarration(oSpeaker, "James arrive at hostel and notice Adha.");
  Wait(300);
  ShowNarration(oSpeaker, "James walk to Adha.");
  Wait(120);
  HideDialogue(oSpeaker);
  Wait(60);
  
  ShowDialogue(oSpeaker, "Uhmm, Adha", 6);
  Wait(180);
  
  ShowDialogue(oSpeaker, "What's wrong James", 7);
  Wait(180);
  
  ShowDialogue(oSpeaker, "The exam is in 5 days, do you want to study together?",  6);
  Wait(300);
  HideDialogue(oSpeaker);
  
  ShowChoices("Study with James", "Decline it", "");
}
function room_RepExec()
{
  if (LastChoice == 1){
    ShowNarration(oSpeaker, "Sure.");
    HideDialogue(oSpeaker);
    PlayVideo("Videos/Adha_OpenBook.ogv", eVideoSkipEscKey, 0);
    SetBackgroundFrame(1);
    ShowNarration(oSpeaker, "They study until night and tomorrow came");
    player.ChangeRoom(6);
  }
  else if (LastChoice == 2){
    ShowNarration(oSpeaker, "");
  }
}
