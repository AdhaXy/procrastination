// Dialogue function --------------------------------------- this mean we add this function
function ShowDialogue(Object* speaker, String text, int speakerSprite) {
  speaker.Graphic = speakerSprite;
  labelDialogue.Text = text;
  gDialogue.Visible = true;
  speaker.Visible = true;
}

function ShowAziz(Object* speaker, String text, int speakerSprite){
  speaker.SetPosition(240, 840);
  speaker.Graphic = speakerSprite;
  Label_Aziz.Text = text;
  gDialogue_Aziz.Visible = true;
  speaker.Visible = true;
}

function ShowJames(Object* speaker, String text, int speakerSprite){
  speaker.SetPosition (240, 840);
  speaker.Graphic = speakerSprite;
  Label_James.Text = text;
  gDialogue_James.Visible = true;
  speaker.Visible = true;
}

function ShowAdha(Object* speaker, String text, int speakerSprite){
  speaker.SetPosition(240, 840);
  speaker.Graphic = speakerSprite;
  Label_Adha.Text = text;
  gDialogue_Adha.Visible = true;
  speaker.Visible = true;
}

function HideDialogue(Object* speaker) {
  gDialogue.Visible = false;
  gDialogue_Aziz.Visible = false;
  gDialogue_James.Visible = false;
  gDialogue_Adha.Visible = false;
  speaker.Visible = false;
}

function ShowNarration(Object* speaker, String text) {
  labelDialogue.Text = text;
  gDialogue.Visible = true;
  speaker.Visible = false;
}

int LastChoice;
export LastChoice;

function ButtonChoice1_OnClick(GUIControl *control, MouseButton button) {
  LastChoice = 1;
  gChoices.Visible = false;
}

function ButtonChoice2_OnClick(GUIControl *control, MouseButton button) {
  LastChoice = 2;
  gChoices.Visible = false;
}

function ButtonChoice3_OnClick(GUIControl *control, MouseButton button) {
  LastChoice = 3;
  gChoices.Visible = false;
}

function ShowChoices(String text1, String text2, String text3) {
  gChoices.SetPosition(480, 0);
  ButtonChoice1.Text = text1;
  ButtonChoice2.Text = text2;
  
  if (text3 == ""){
    ButtonChoice3.Visible = false;
    
    gChoices.SetPosition(gChoices.X, 182);
  }
  else {
    ButtonChoice3.Text = text3;
    ButtonChoice3.Visible = true;
  }
  
  LastChoice = 0; // reset before showing
  gChoices.Visible = true;
  
}


